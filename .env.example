# ============================================================
# .env.example — INDOSARI Akuntansi 2026 Web App
# Copy this file to .env (local) or set in Netlify dashboard (production)
# ============================================================

# ---- DATABASE ----
# Local dev (SQLite): file-based DB, no setup needed
DATABASE_URL="file:./db/custom.db"
DIRECT_URL=""

# Production (Netlify + Supabase Postgres free):
# 1. Daftar akun gratis di https://supabase.com (free 500 MB DB + 50k MAU)
# 2. Buat project baru → klik tombol "Connect" (pojok kanan atas)
# 3. Pilih tab "ORMs" → "Prisma" → Supabase akan generate 2 connection string:
#
#    DATABASE_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
#    DIRECT_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
#    Penting:
#    - DATABASE_URL = transaction pooler (port 6543 + pgbouncer=true) untuk runtime app
#    - DIRECT_URL   = session pooler (port 5432, tanpa pgbouncer) untuk migrations/db push
#    - Ganti [PASSWORD] dengan password database yang Anda buat saat setup Supabase
#    - Set KEDUA env vars ini di Netlify dashboard

# ---- AUTH ----
# Secret untuk sign JWT session cookies. WAJIB di-set untuk production.
# Generate random 32-byte base64: jalankan `openssl rand -base64 32` di terminal
# atau gunakan https://generate-secret.vercel.app/32 (string random)
NEXTAUTH_SECRET="indosari-akuntansi-2026-secret-key-change-in-prod"

# URL aplikasi (untuk callback URL NextAuth)
# Local dev: http://localhost:3000
# Production: https://nama-project-anda.netlify.app (atau custom domain)
NEXTAUTH_URL="http://localhost:3000"
