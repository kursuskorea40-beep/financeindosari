# ============================================================
# .env.example — INDOSARI Akuntansi 2026 Web App
# Copy this file to .env (local) or set in Vercel dashboard (production)
# ============================================================

# ---- DATABASE ----
# Local dev (SQLite): file-based DB, no setup needed
DATABASE_URL="file:./db/custom.db"

# Production (Vercel + Neon Postgres free):
# 1. Daftar akun gratis di https://neon.tech (or Vercel Postgres / Supabase)
# 2. Buat project baru, salin connection string
# 3. Set di Vercel Environment Variables:
#    DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
#    (pastikan "?sslmode=require" ada di akhir — Neon butuh SSL)

# ---- AUTH ----
# Secret untuk sign JWT session cookies. WAJIB di-set untuk production.
# Generate random 32-char string: jalankan `openssl rand -base64 32` di terminal
# atau gunakan https://generate-secret.vercel.app/ (NextAuth official generator)
NEXTAUTH_SECRET="indosari-akuntansi-2026-secret-key-change-in-prod"

# URL aplikasi (untuk callback URL NextAuth)
# Local dev: http://localhost:3000
# Production: https://nama-project-anda.vercel.app (atau custom domain)
NEXTAUTH_URL="http://localhost:3000"
